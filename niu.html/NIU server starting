<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NIU Server Status</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #0f172a;
        --panel: #111827;
        --text: #e5e7eb;
        --muted: #cbd5e1;
        --accent: #60a5fa;
        --success: #34d399;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #020617, #111827);
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
      }

      .status-card {
        width: min(720px, calc(100% - 2rem));
        background: rgba(17, 24, 39, 0.9);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
        padding: 2rem 2.25rem;
      }

      h1 {
        margin: 0 0 1rem;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        color: var(--success);
      }

      ul {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
      }

      li {
        margin: 0.75rem 0;
        font-size: 1.05rem;
        color: var(--muted);
      }

      strong {
        color: var(--text);
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .note {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(148, 163, 184, 0.2);
        color: var(--muted);
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <main class="status-card" aria-live="polite">
      <h1 id="server-status">Checking NIU server status…</h1>
      <ul>
        <li><strong>Website:</strong> <a href="http://127.0.0.1:8081/">http://127.0.0.1:8081/</a></li>
        <li><strong>API health:</strong> <a href="http://127.0.0.1:8081/api/health">http://127.0.0.1:8081/api/health</a></li>
      </ul>
      <p class="note" id="status-note">Bound to loopback; accessible only on this computer.</p>
    </main>
    <script>
      const healthUrl = document.querySelector('a[href$="/api/health"]').href;
      const status = document.getElementById("server-status");
      const note = document.getElementById("status-note");

      async function checkServer() {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 5000);

        try {
          const response = await fetch(healthUrl, {
            cache: "no-store",
            signal: controller.signal,
          });
          if (!response.ok) throw new Error("Health check failed");
          status.textContent = "NIU server is running";
          note.textContent = "Bound to loopback; accessible only on this computer.";
        } catch {
          status.textContent = "NIU server is unavailable";
          note.textContent =
            "Could not reach the health endpoint. Check that the server is running on this computer.";
        } finally {
          clearTimeout(timeout);
        }
      }

      checkServer();
      setInterval(checkServer, 10000);
    </script>
  </body>
</html>
